# ============================================
# MA-Buybacks Environment Configuration
# ============================================
# Copy this to .env.local and fill in your values

# ============================================
# CRITICAL - Required for Production
# ============================================

# Executor Wallet Private Key
# SECURITY: This key controls all user funds. Store securely!
# Format: 0x... (64 hex chars) or ed25519-priv-0x...
EXECUTOR_PRIVATE_KEY=

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # Use service role key, NOT anon key

# Mosaic DEX API
MOSAIC_API_KEY=

# Shinami Gas Station (for gasless transactions)
SHINAMI_GAS_STATION_API_KEY=

# Cron Job Authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ============================================
# Optional - Enhanced Features
# ============================================

# CoinMarketCap API (for token price display)
# If not provided, falls back to CoinGecko (rate limited)
COINMARKETCAP_API_KEY=

# ============================================
# Development Only
# ============================================

# Enable verbose logging (don't use in production)
# DEBUG=true

# Use testnet instead of mainnet
# NEXT_PUBLIC_TESTNET=true
